# ── Data ──────────────────────────────────────────────────────────────
# memory = seeded in-process store (local dev, no setup). supabase = Postgres.
# If unset: supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY exist, else memory.
DATA_BACKEND=
# Persist the memory store to .data/db.json (1/0)
MEMORY_PERSIST=1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser realtime (admin live updates). Without these, the app uses SSE from the memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=klara

# ── LLM (Anthropic) ───────────────────────────────────────────────────
# live = call Claude. mock = keyword-based stand-in for offline UI work (clearly not the real agent).
# If unset: live when ANTHROPIC_API_KEY exists, else mock.
LLM_MODE=
ANTHROPIC_API_KEY=
# Verify the current model ID in Anthropic docs (SPEC D10).
ANTHROPIC_MODEL=
# Optional cheaper model for phrasing/translation calls; falls back to ANTHROPIC_MODEL.
ANTHROPIC_MODEL_FAST=

# ── Voice (M3) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
STT_MODEL=
# openai | elevenlabs
TTS_PROVIDER=openai
TTS_MODEL=
TTS_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Email (M4, Postmark) ──────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
# Shared secret in the inbound webhook URL (?token=...) to reject foreign posts.
POSTMARK_INBOUND_TOKEN=
# Address the "Bauherr" demo mailbox replies from (for the demo page).
DEMO_CLIENT_MAILBOX=

# ── Demo ──────────────────────────────────────────────────────────────
# Optional fixed demo "now" (ISO). The /admin/demo clock offset is added on top.
DEMO_NOW=
