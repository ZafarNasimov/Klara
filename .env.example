# Klara – environment variables. Copy to .env.local for local development.
# Everything has a local fallback: without any keys Klara runs with an
# in-memory store and a keyword-based test extractor (no AI model).

# ── Data ───────────────────────────────────────────────────────────────
# memory | supabase. Default: supabase when SUPABASE_URL + service key are set.
DATA_BACKEND=
# memory backend: 0 disables writing .data/db.json
MEMORY_PERSIST=1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser realtime (Supabase Realtime on the `event` table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=klara

# ── LLM (Anthropic) ────────────────────────────────────────────────────
# Each KLARA_ANTHROPIC_* name wins over the plain ANTHROPIC_* name. Use the
# KLARA_ names in Claude Code cloud environments (they reserve ANTHROPIC_*);
# locally and on Vercel either name works.
# live | mock. Default: live when a key is set.
LLM_MODE=
KLARA_ANTHROPIC_API_KEY=
# Extraction model (record_turn). Verify current IDs in the Anthropic docs.
KLARA_ANTHROPIC_MODEL=claude-sonnet-5-5
# Small calls: phrasing in the user's language, translation.
KLARA_ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Optional output_config.effort for the extraction call: low | medium | high
KLARA_ANTHROPIC_EFFORT=low

# ── Voice (M3) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
# openai | elevenlabs
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── E-mail through a normal mailbox (SMTP send, IMAP replies) ──────────
# Wins over Postmark when set. Gmail: create an app password (needs 2-Step
# Verification) at https://myaccount.google.com/apppasswords; hosts are known.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Markus Hofmann, Bauleitung Muster Bau GmbH
# Other providers (e.g. IONOS, GMX): hosts are required, ports default to 465 / 993
MAIL_SMTP_HOST=
MAIL_IMAP_HOST=

# ── Site password ──────────────────────────────────────────────────────
# Login page in front of the whole app (set it on any public deployment). Empty = no login.
SITE_PASSWORD=

# ── E-mail (M4, Postmark) ──────────────────────────────────────────────
# Without a server token "Senden" is a test send: logged in the case, nothing leaves the app.
POSTMARK_SERVER_TOKEN=
# Sender with a confirmed Postmark sender signature, e.g. "Muster Bau Bauleitung <bauleitung@your-domain.de>"
POSTMARK_FROM=
# Optional Reply-To: the Postmark inbound address, so the client's answer reaches the webhook
POSTMARK_REPLY_TO=
# Shared secret in the inbound webhook URL: /api/email/inbound?token=...
POSTMARK_INBOUND_TOKEN=
# Mailbox the teammate uses as "Bauherr" in the demo (seeded contact email)
DEMO_CLIENT_MAILBOX=

# ── Demo ───────────────────────────────────────────────────────────────
# Optional start instant for the demo clock (ISO 8601); the clock keeps running from there.
DEMO_NOW=
# 1 skips the Open-Meteo weather lookup (e.g. offline)
WEATHER_DISABLED=

# ── Latency measurement (dev only) ─────────────────────────────────────
# Voice and chat turns always log "[klara] timing …" and send Server-Timing.
# 1 splits the "db" step per operation and table (db.get.case, …)
TIMING_DB_DETAIL=
# Memory backend only: delay every store call by this many ms (~110 = Supabase
# from a laptop) to measure round trips without writing to Supabase.
DB_SIMULATED_LATENCY_MS=
